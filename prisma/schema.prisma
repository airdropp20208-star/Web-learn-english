// Schema cho Web Learn English.
//
// Ba nhóm model:
//   1. Auth.js v5  — User / Account / Session / VerificationToken
//   2. Học tập     — Text, VocabItem, MemoryItem (FSRS), QuizQuestion,
//                    UserProgress, ShadowSession
//   3. Trạng thái người học — GamificationState, DeckSubscription,
//                    DeckCardState, PathProgress
//
// Nhóm 3 trước đây chỉ sống trong localStorage và chưa từng có model nào.
//
// Mọi bảng đồng bộ được đều có `updatedAt`: cơ chế giải xung đột là
// last-write-wins theo trường này (xem src/app/api/sync/route.ts).
//
// Cố ý KHÔNG dùng `@updatedAt` trên các bảng đó. Attribute ấy bắt Prisma tự
// đóng dấu now() mỗi lần ghi, nghĩa là bản ghi vừa nhận từ client luôn trở
// thành bản mới nhất — máy còn lại sẽ không bao giờ thắng được và LWW mất
// nghĩa. Ở đây mốc thời gian do client gửi lên và server ghi nguyên vẹn.
// `User.updatedAt` vẫn giữ `@updatedAt` vì bảng đó không tham gia đồng bộ.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: chuỗi kết nối không còn nằm ở đây.
  // Migrate đọc từ prisma.config.ts; runtime nhận qua driver adapter
  // trong src/lib/prisma.ts.
}

// ============================================================
// Kiểu liệt kê
// ============================================================
// Tên thành viên trùng đúng chuỗi mà tầng DTO dùng, nên kiểu Prisma sinh ra
// gán thẳng được vào các union trong src/lib/types.ts, không cần map.

enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum ItemType {
  word
  grammar
  gist
}

enum QuizType {
  mcq
  cloze
  recall
}

// ============================================================
// 1. Auth.js v5
// ============================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  /// Chỉ có khi đăng ký bằng email + mật khẩu. Đăng nhập OAuth để null.
  passwordHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts       Account[]
  sessions       Session[]
  texts          Text[]
  memoryItems    MemoryItem[]
  vocabItems     VocabItem[]
  quizQuestions  QuizQuestion[]
  shadowSessions ShadowSession[]
  userProgress   UserProgress?
  gamification   GamificationState?
  pathProgress   PathProgress?
  deckSubs       DeckSubscription[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// 2. Học tập
// ============================================================

model Text {
  id        String    @id @default(cuid())
  userId    String
  title     String
  content   String    @db.Text
  cefrLevel CefrLevel @default(B1)
  summary   String?   @db.Text

  /// Điểm dễ đọc tính ở client (Flesch-Kincaid…). `null` = chưa tính,
  /// khác hẳn với "đã tính ra 0".
  readability Json?

  createdAt DateTime @default(now())
  updatedAt DateTime

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  memoryItems    MemoryItem[]
  vocabItems     VocabItem[]
  quizQuestions  QuizQuestion[]
  shadowSessions ShadowSession[]

  @@index([userId, createdAt])
}

/// Một thẻ ôn tập. Các trường FSRS là cột riêng chứ không phải JSON blob:
/// truy vấn "thẻ nào đến hạn" phải lọc được bằng index trên `due`.
model MemoryItem {
  id           String    @id @default(cuid())
  userId       String
  sourceTextId String
  itemType     ItemType  @default(word)
  refText      String    @db.Text
  cefrLevel    CefrLevel @default(B1)

  // --- Trạng thái FSRS (ts-fsrs v5) ---
  due           DateTime  @default(now())
  stability     Float     @default(0)
  difficulty    Float     @default(0)
  elapsedDays   Float     @default(0)
  scheduledDays Float     @default(0)
  /// Vị trí trong chuỗi bước học/học lại. Thiếu nó là lịch ôn sai.
  learningSteps Int       @default(0)
  reps          Int       @default(0)
  lapses        Int       @default(0)
  /// 0=New, 1=Learning, 2=Review, 3=Relearning
  state         Int       @default(0)
  lastReview    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceText Text       @relation(fields: [sourceTextId], references: [id], onDelete: Cascade)
  vocabItem  VocabItem?

  @@index([userId, due])
  @@index([sourceTextId])
}

model VocabItem {
  id                String    @id @default(cuid())
  userId            String
  word              String
  definition        String    @db.Text
  vietnamese        String?
  exampleSentence   String    @db.Text
  exampleVietnamese String?   @db.Text
  contextSentence   String    @db.Text
  cefrLevel         CefrLevel @default(B1)
  ipa               String?
  audioUrl          String?
  sourceTextId      String
  memoryItemId      String    @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceText Text       @relation(fields: [sourceTextId], references: [id], onDelete: Cascade)
  memoryItem MemoryItem @relation(fields: [memoryItemId], references: [id], onDelete: Cascade)

  @@index([userId, word])
  @@index([sourceTextId])
}

model QuizQuestion {
  id                  String   @id @default(cuid())
  userId              String
  textId              String
  type                QuizType
  question            String   @db.Text
  options             String[]
  correctAnswer       String   @db.Text
  relatedMemoryItemId String?
  createdAt           DateTime @default(now())

  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceText Text @relation(fields: [textId], references: [id], onDelete: Cascade)

  @@index([userId, textId])
}

model UserProgress {
  id               String    @id @default(cuid())
  userId           String    @unique
  currentTier      CefrLevel @default(A2)
  tierMasteryScore Float     @default(0)
  streakDays       Int       @default(0)
  lastActiveDate   DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ShadowSession {
  id               String   @id @default(cuid())
  userId           String
  textId           String
  audioUrl         String   @default("")
  userRecordingUrl String   @default("")
  completedAt      DateTime @default(now())

  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceText Text @relation(fields: [textId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt])
}

// ============================================================
// 3. Trạng thái người học (trước đây chỉ có trong localStorage)
// ============================================================

model GamificationState {
  id     String @id @default(cuid())
  userId String @unique

  coins  Int @default(0)
  xp     Int @default(0)
  level  Int @default(1)
  streak Int @default(0)

  /// Dạng YYYY-MM-DD theo giờ máy người học, không phải UTC — "hôm nay" là
  /// hôm nay của họ. Vì vậy để String chứ không phải DateTime.
  lastStudyDate String?

  /// Tiến độ trong ngày. Gộp thẳng vào đây thay vì tách bảng: mỗi người học
  /// chỉ có đúng một ngày đang mở, và nó bị ghi đè khi sang ngày mới.
  progressDate  String @default("")
  wordsLearned  Int    @default(0)
  wordsReviewed Int    @default(0)
  gamesPlayed   Int    @default(0)

  achievements String[]

  createdAt DateTime @default(now())
  updatedAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DeckSubscription {
  id     String @id @default(cuid())
  userId String
  deckId String

  subscribedAt DateTime @default(now())
  /// Vị trí các từ đã học, trỏ vào mảng words của bộ từ tĩnh.
  studiedWords Int[]

  createdAt DateTime @default(now())
  updatedAt DateTime

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardStates DeckCardState[]

  @@unique([userId, deckId])
  @@index([userId])
}

/// Thẻ FSRS của một từ trong bộ từ dựng sẵn. Tách khỏi `MemoryItem` vì từ ở
/// đây không thuộc `Text` nào của người dùng — nó đến từ dữ liệu tĩnh.
model DeckCardState {
  id             String @id @default(cuid())
  subscriptionId String
  word           String

  due           DateTime  @default(now())
  stability     Float     @default(0)
  difficulty    Float     @default(0)
  elapsedDays   Float     @default(0)
  scheduledDays Float     @default(0)
  learningSteps Int       @default(0)
  reps          Int       @default(0)
  lapses        Int       @default(0)
  state         Int       @default(0)
  lastReview    DateTime?

  updatedAt DateTime

  subscription DeckSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, word])
  @@index([subscriptionId, due])
}

model PathProgress {
  id     String @id @default(cuid())
  userId String @unique

  completedLessons String[]
  /// lessonId -> điểm cao nhất (phần trăm). Khoá là id bài học tuỳ ý nên
  /// dùng Json thay vì bảng riêng cho một map nhỏ.
  lessonScores  Json      @default("{}")
  learnedWords  String[]
  lastStudiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
