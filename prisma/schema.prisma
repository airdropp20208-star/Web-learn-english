// Prisma schema for Web Learn English app
// NextAuth v4 (CredentialsProvider with username+password) + app data models

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Postgres for both local dev and Vercel prod
  // Local: set DATABASE_URL in .env to your Vercel Postgres connection string
  // Vercel: DATABASE_URL auto-set when you connect Postgres storage to project
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================
// NextAuth models (kept for compatibility, even if CredentialsProvider
// doesn't use Account/Session tables, leaving them avoids migration headaches)
// =====================

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  passwordHash  String
  name          String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  texts          Text[]
  memoryItems    MemoryItem[]
  vocabItems     VocabItem[]
  quizQuestions  QuizQuestion[]
  userProgress   UserProgress?
  shadowSessions ShadowSession[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =====================
// App models
// =====================

model Text {
  id         String   @id @default(cuid())
  userId     String
  title      String
  content    String
  cefrLevel  String   @default("B1")
  summary    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  memoryItems    MemoryItem[]
  vocabItems     VocabItem[]
  quizQuestions  QuizQuestion[]
  shadowSessions ShadowSession[]

  @@index([userId, createdAt])
}

model MemoryItem {
  id              String   @id @default(cuid())
  userId          String
  sourceTextId    String
  itemType        String   @default("word")
  refText         String
  cefrLevel       String   @default("B1")
  halfLifeDays    Float    @default(1.0)
  lastReviewedAt  DateTime @default(now())
  correctHistory  String   @default("[]")
  latencyHistory  String   @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceText Text       @relation(fields: [sourceTextId], references: [id], onDelete: Cascade)
  vocabItem  VocabItem?

  @@index([userId, lastReviewedAt])
}

model VocabItem {
  id              String   @id @default(cuid())
  userId          String
  word            String
  definition      String
  exampleSentence String
  contextSentence String
  cefrLevel       String   @default("B1")
  sourceTextId    String
  memoryItemId    String   @unique
  createdAt       DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceText Text       @relation(fields: [sourceTextId], references: [id], onDelete: Cascade)
  memoryItem MemoryItem @relation(fields: [memoryItemId], references: [id], onDelete: Cascade)

  @@index([userId, word])
}

model QuizQuestion {
  id                  String   @id @default(cuid())
  userId              String
  textId              String
  type                String
  question            String
  options             String   @default("[]")
  correctAnswer       String
  relatedMemoryItemId String?
  createdAt           DateTime @default(now())

  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceText Text @relation(fields: [textId], references: [id], onDelete: Cascade)

  @@index([userId, textId])
}

model UserProgress {
  id              String   @id @default(cuid())
  userId          String   @unique
  currentTier     String   @default("A2")
  tierMasteryScore Float   @default(0.0)
  streakDays      Int      @default(0)
  lastActiveDate  DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ShadowSession {
  id              String   @id @default(cuid())
  userId          String
  textId          String
  audioUrl        String   @default("")
  userRecordingUrl String  @default("")
  completedAt     DateTime @default(now())

  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceText Text @relation(fields: [textId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt])
}
