# ==========================================================================
# Learn English — biến môi trường
# ==========================================================================
# App chạy được với file này để trống hoàn toàn: không có database thì vào
# chế độ khách (dữ liệu nằm trong localStorage), không có khoá Gemini thì các
# tính năng AI hiện thông báo "chưa cấu hình" thay vì lỗi.
#
# Chép sang `.env.local` rồi điền những phần bạn cần.

# ============ Database (bật tài khoản + đồng bộ đa thiết bị) ============
# Postgres. Neon (https://neon.tech) có bậc miễn phí hợp với Vercel.
# Thiếu biến này thì trang /dang-nhap báo "chưa bật tài khoản" và app chạy
# nguyên vẹn ở chế độ khách.
DATABASE_URL=""

# ============ Auth.js ============
# Khoá ký cookie phiên. Bắt buộc khi đã có DATABASE_URL.
# Sinh khoá: npx auth secret     (hoặc: openssl rand -base64 32)
AUTH_SECRET=""

# URL công khai của app. Vercel tự đặt; chỉ cần khai khi chạy sau proxy hoặc
# tên miền riêng. Local để trống là được.
# AUTH_URL="http://localhost:3000"

# ============ GitHub OAuth (tuỳ chọn) ============
# Chỉ khi có ĐỦ CẢ HAI thì nút "Tiếp tục với GitHub" mới hiện ra.
# Tạo tại https://github.com/settings/developers
# Callback URL: <AUTH_URL>/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ============ Gemini AI (phân tích bài đọc, sinh quiz) ============
# Lấy khoá miễn phí tại https://aistudio.google.com/apikey
# Nhiều khoá để xoay vòng khi bị giới hạn: ngăn bằng dấu phẩy, không khoảng trắng.
# Ví dụ: key1,key2,key3
GEMINI_API_KEYS=""
