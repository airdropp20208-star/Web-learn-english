# Learn English — Environment Variables
# Copy this file to .env (local) or set on Vercel dashboard (prod)
# .env is gitignored and never committed

# ============ Database ============
# Local dev: SQLite file (relative to project root)
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# Prod (Vercel): use Vercel Postgres or Turso SQLite
# Example Vercel Postgres: postgres://user:pass@host/db
# Example Turso: libsql://your-db.turso.io

# ============ NextAuth ============
# Required for JWT signing. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Production URL of your app (no trailing slash)
# Local dev: http://localhost:3000
# Vercel: https://your-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# ============ GitHub OAuth ============
# Create OAuth App: GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
# Homepage URL: http://localhost:3000 (dev) or https://your-app.vercel.app (prod)
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
#                              (replace with prod URL for Vercel)
GITHUB_ID=""
GITHUB_SECRET=""

# ============ Gemini AI ============
# Get free keys at https://aistudio.google.com/apikey
# Multiple keys for rotation: comma-separated, no spaces
# Example: key1,key2,key3
GEMINI_API_KEYS=""
