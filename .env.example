# Learn English — Environment Variables
# Copy this file to .env (local) or set on Vercel dashboard (prod)
# .env is gitignored and never committed

# ============ Database (REQUIRED) ============
# Using Postgres for both local dev and Vercel prod
#
# Vercel setup:
#   1. Vercel dashboard → Project → Storage tab → Create Database → Postgres (free)
#   2. Connect database to your project → DATABASE_URL auto-set
#
# Local dev:
#   Copy the connection string from Vercel dashboard (.env.local tab)
#   Format: postgres://user:password@host:port/dbname
DATABASE_URL="postgres://..."

# ============ NextAuth (REQUIRED) ============
# Required for JWT signing. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Production URL of your app (no trailing slash)
# Local dev: http://localhost:3000
# Vercel: https://your-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# ============ Gemini AI (REQUIRED for AI features) ============
# Get free keys at https://aistudio.google.com/apikey
# Multiple keys for rotation: comma-separated, no spaces
# Example: key1,key2,key3
GEMINI_API_KEYS=""
